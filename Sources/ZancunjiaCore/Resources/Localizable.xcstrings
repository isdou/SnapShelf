        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard media is stored locally only and cleared on quit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板媒体只暂存在本机，退出即清空"
