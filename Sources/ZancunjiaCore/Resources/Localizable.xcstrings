    "empty.drag_capsule": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can still drag images or videos to the top capsule"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍可把图片或视频拖到顶部胶囊上"
          }
        }
      }
    },
    "empty.sidebar_capture": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press ⌃⌘⇧4 to copy a screenshot, or drag images and videos in.\nStored on this computer only, cleared on quit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 ⌃⌘⇧4 截到剪贴板，或直接拖入图片和视频。\n只暂存在本机，退出后清空。"
          }
        }
      }
    },
    "empty.sidebar_paused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can still drag images or videos in.\nTurn auto-collect back on from the SnapShelf menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍可把图片或视频拖进来。\n可在 SnapShelf 菜单重新开启自动收集。"
          }
        }
      }
    },
